# Telegram Bot Token (https://t.me/botfather adresinden alınır)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# N8N Webhook URL (N8N'de oluşturduğunuz webhook URL'si)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/telegram

# API Sunucusu Port (N8N'den mesaj göndermek için)
API_PORT=5000

# Debug Mode (true/false)
DEBUG=false

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Request Timeout (saniye cinsinden)
REQUEST_TIMEOUT=10
